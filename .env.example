# Required for the production PostgreSQL database.
DATABASE_URL=
# Required to initialize the first admin when the database has no admin users.
OWNER_PHONE=
OWNER_PASSWORD=
# Optional order notifications. Configure these on your server/hosting provider.
ORDER_NOTIFICATION_EMAIL=orders@your-domain.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Web Push alerts for installed Admin/Mini App browsers (generate with `npx web-push generate-vapid-keys`).
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=https://milanofoods.vercel.app
# Comma-separated SHA-256 fingerprints of the Android APK signing certificate(s).
ANDROID_SHA256_CERT_FINGERPRINTS=
# Optional: direct APK asset URL shown in the Mini App after the first GitHub release.
NEXT_PUBLIC_ANDROID_APK_URL=
# Direct Mini App login (keep these values in deployment secrets, never in source control).
MINIAPP_LOGIN_PHONE=
MINIAPP_LOGIN_PASSCODE=
MINIAPP_SESSION_SECRET=
# Optional SMTP provider credentials if you implement SMTP in the notification endpoint.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
